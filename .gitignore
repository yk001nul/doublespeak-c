# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
# Exception: prebuilt MSVC binaries vendored in deps/ (no package manager on this machine)
!meteor_stego/deps/libsodium/**/*.lib

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Build directories
meteor_stego/out/
doublespeak/out/
build/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# VS artifacts
.vs/
*.vsidx
*.db-shm
*.db-wal
*.wsuo

# Runtime (generated by cmake configure_file)
meteor_stego/out/build/*/llama_server.log
meteor_stego/out/build/*/llama_server.pid

# Model files (too large for git)
*.gguf

# Python
__pycache__/
*.pyc

# Terraform
# Provider plugins and the local state cache are machine-specific. *.tfvars is
# ignored because it is where deployment-specific values (and eventually
# secrets) accumulate — keep the standing var set local to each checkout rather
# than committed. The lock file is deliberately NOT ignored: pinning provider
# versions across machines is the point of it.
infra/terraform/.terraform/
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
crash.log
